rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is authenticated and is their own doc
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Helper to check if user is authenticated and has admin role
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection rules
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid &&
                    (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
                    (!('activeDebt' in request.resource.data) || request.resource.data.activeDebt == 0) &&
                    (!('happyPoints' in request.resource.data) || request.resource.data.happyPoints == 0) &&
                    (!('activeOrders' in request.resource.data) || request.resource.data.activeOrders == 0);
      
      // Updates: owner can update, but cannot touch activeDebt, happyPoints, role, or activeOrders,
      // and customerCode is immutable once set. Admin has full rights.
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeDebt', 'happyPoints', 'role', 'activeOrders']) &&
        (
          !('customerCode' in resource.data) ||
          request.resource.data.customerCode == resource.data.customerCode
        )
      );
    }

    // reviews collection rules
    match /reviews/{reviewId} {
      // Public read for approved reviews, admin can read all
      allow read: if (resource != null && resource.data.status == 'approved') || isAdmin();
      // Allow creation of pending reviews by anyone (admin approves them later)
      allow create: if request.resource.data.status == 'pending' &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5 &&
                    request.resource.data.content.size() >= 10;
      // Allow update/delete by owner (only if status is pending) or admin
      allow update, delete: if isAdmin() || (
        request.auth != null && 
        resource.data.uid == request.auth.uid && 
        resource.data.status == 'pending' && 
        (!('status' in request.resource.data) || request.resource.data.status == 'pending')
      );
    }

    // customerCodes collection (lookup to guarantee uniqueness)
    match /customerCodes/{code} {
      allow read: if request.auth != null || isAdmin();
      // Allow creation during onboarding if it maps to user's UID and is not already taken
      allow create: if request.auth != null && 
                    request.resource.data.uid == request.auth.uid &&
                    resource == null;
      allow update, delete: if false; // Immutable
    }

    // orders collection rules
    match /orders/{orderId} {
      // Allow get publicly (order ID known) but restrict listing/querying to owner or admin
      allow get: if true;
      allow list: if isAdmin() || (request.auth != null && resource.data.customerUID == request.auth.uid);
      // Allow creation by logged-in user
      allow create: if request.auth != null && (request.resource.data.customerUID == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // movements collection rules (server-only write, client-read-only)
    match /movements/{movementId} {
      allow read, get, list: if isAdmin() || (request.auth != null && resource.data.customerUID == request.auth.uid);
      allow write: if isAdmin(); // Admin can adjust or write movements
    }

    // debtContracts collection rules (server-only write, client-read-only)
    match /debtContracts/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // creditScores collection rules (server-only write, client-read own)
    match /creditScores/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin(); // Only server (Admin SDK) may set scores
    }

    // verificationPins collection (server-only write, no client reads)
    match /verificationPins/{uid} {
      allow read: if false; // Never expose PIN hashes to client
      allow write: if isAdmin();
    }
    match /shortlinks/{code} {
      allow get: if true;
      allow write: if isAdmin();
    }

    // loginHistory - written server-side only; readable only by admins
    match /loginHistory/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // config collection rules - topProducts is publicly readable; all other config is admin-only
    match /config/{documentId} {
      allow read: if documentId == 'topProducts' || isAdmin();
      allow write: if false; // only Admin SDK can write
    }

    // products collection rules (public read, admin write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // storeSettings collection rules (public read, admin write)
    match /storeSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // banned_entities collection rules
    match /banned_entities/{entityId} {
      allow read, write: if isAdmin();
    }

    // HappyNotas - academics (calificaciones académicas encriptadas)
    match /academics/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // HappyNotas - userDefaults (configuración y pesos de usuario)
    match /userDefaults/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == docId;
    }

    // HappyNotas - notes (calificaciones académicas obsoletas)
    match /notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // sharedLinks - enlaces públicos para compartir notas
    match /sharedLinks/{linkId} {
      // Cualquiera puede leer (acceso público via link)
      allow read: if true;
      // Solo el propietario puede crear/actualizar/eliminar links
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    
    // publicNotes - vista pública de notas compartidas
    match /publicNotes/{noteId} {
      // Lectura pública para notas compartidas
      allow read: if true;
      allow write: if false; // Solo backend puede escribir
    }
  }
}
